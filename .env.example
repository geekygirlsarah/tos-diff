# Copy this file to .env and fill in the values before running docker-compose.
# Never commit .env to version control.

# ── Django ────────────────────────────────────────────────────────────────────
# Generate a strong key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Set to "false" in production
DJANGO_DEBUG=false

# Comma-separated list of hostnames the app is served from, e.g. example.com,www.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Absolute base URL for email links (used by Celery tasks)
BASE_URL=http://localhost:8000

# ── Email ──────────────────────────────────────────────────────────────────────
# Two separate delivery paths (Django 6.1 MAILERS):
#   1. "default"  → transactional mail (OTP login codes, suggestion replies,
#                   daily/weekly change digests) via Mailgun's HTTP API.
#   2. "admin"    → Django error reports + mail_admins() via SMTP.
# If MAILGUN_API_KEY is unset, the default mailer falls back to the console
# backend (prints emails to the terminal) — handy for local development.

# Mailgun — transactional mail
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Optional: default https://api.mailgun.net ; EU region: https://api.eu.mailgun.net
# MAILGUN_API_URL=https://api.mailgun.net
# MAILGUN_TIMEOUT=30

# SMTP — admin/ops mail (error reports to ADMINS)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_TIMEOUT=30

# From addresses
# NOTE: DEFAULT_FROM_EMAIL must use a sender on MAILGUN_DOMAIN for transactional
# mail to be accepted by Mailgun, e.g. "TosDiff <no-reply@mg.example.com>".
DEFAULT_FROM_EMAIL="TosDiff <no-reply@tosdiff.local>"

# Comma-separated recipient(s) for admin error emails (SMTP).
# DJANGO_ADMIN_EMAILS=admin@example.com
# SERVER_EMAIL="TosDiff Admin <admin@tosdiff.local>"

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_NAME=tosdiff
DB_USER=tosdiff
DB_PASSWORD=change-me-strong-password

# ── Gunicorn ──────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_LOG_LEVEL=info
CELERY_CONCURRENCY=2

# ── Web port (host-side) ──────────────────────────────────────────────────────
WEB_PORT=8000
