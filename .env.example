# Copy this file to .env and fill in the values before running docker-compose.
# Never commit .env to version control.

# ── Django ────────────────────────────────────────────────────────────────────
# Generate a strong key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Set to "false" in production
DJANGO_DEBUG=false

# Comma-separated list of hostnames the app is served from, e.g. example.com,www.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Absolute base URL for email links (used by Celery tasks)
BASE_URL=http://localhost:8000

# ── Email (for OTP login codes and change notifications) ─────────────────────
# Default: console backend (prints to terminal).  Use SMTP in production.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="TosDiff <no-reply@tosdiff.local>"

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_NAME=tosdiff
DB_USER=tosdiff
DB_PASSWORD=change-me-strong-password

# ── Gunicorn ──────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_LOG_LEVEL=info
CELERY_CONCURRENCY=2

# ── Web port (host-side) ──────────────────────────────────────────────────────
WEB_PORT=8000
